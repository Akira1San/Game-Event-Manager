when 1 is pressed
  spawn prefab "Hero" at SpawnPoint 1
  print "spawn hero"

when 2 is pressed
  spawn prefab "Hero" at SpawnPoint 2
  print "spawn hero again"

when 3 is pressed
  spawn prefab "Hero" at SpawnPoint 3
  print "spawn hero B"

when Escape is pressed
  unless OverlayOpen is 1
  add scene "escape_scene_overlay"
  set OverlayOpen to 1
  print "overlay added"

when Q is pressed
  unless OverlayOpen is 0
  unload scene "escape_scene_overlay"
  set OverlayOpen to 0
  print "overlay removed"
