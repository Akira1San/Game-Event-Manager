# ---------------- Player.events ----------------

# ---- movement ----
when W is held
  unless Left Shift is held
  move forward speed 45

when Left Shift is held
  W is held
  move forward speed 90

when S is held
  unless Left Shift is held
  move back speed 45

when Left Shift is held
  S is held
  move back speed 90

when A is held
  unless Left Shift is held
  move left speed 50

when Left Shift is held
  A is held
  move left speed 90

when D is held
  unless Left Shift is held
  move right speed 50

when Left Shift is held
  D is held
  move right speed 90

# ---- mouse rotation: user opts in here; C# faces the player toward the mouse ----
when game starts
  set LookAtMouse to 1

# ---- shooting: fire in the direction the player faces ----
when Left Mouse is pressed
  spawn Bullet at me
  play sound "shot"

when Space is pressed
  play sound "shot"

# ---- getting hurt: brief invulnerability by hiding ----
when me overlaps Enemy
  unless my Invulnerable is true
  play sound "hurt.wav"
  add -1 to Lives
  set my Invulnerable to true
  hide me
  wait 1 second
  show me
  set my Invulnerable to false
