# ---------------- EnemyTypes.events (Task 16 Part D: typed enemy data) ----------------
# Typed enemy definitions, data-driven. `enemy type "Zombie"` copies a type's stats onto the
# enemy's own variables (my Speed, my SightDistance, my Health, my Weapon, my Hostile,
# my ExplosionDeath, my Level, my Type), so an enemy sheet never hard-codes them.
#
# HOW IT LOADS: the file is read when the game loads events (and on hot reload), by name —
# EnemyTypes.events — before any actor's `when me appears` runs, so a type is complete on the
# first tick. Attaching it to a sheet is optional; the `when game starts` block below keeps it
# valid as a normal event file.
#
# UNITS: the built-in defaults are TK4's metres (Zombie speed 2, sight 10). This project's TK
# scenes are authored in centimetres (the player moves 45-200, the camera sits at 600), so the
# table below scales a Zombie to 100 cm/s and 200 cm of sight — otherwise the enemy would be
# blind at 10 cm and never chase. Change a type here, not in code.

when game starts
  set ZombieSpeed to 60
  set ZombieSightDistance to 200
  set ZombieHealth to 50
  set ZombieWeapon to "Claws"
  set ZombieHostile to true
  set ZombieExplosionDeath to false
  set ZombieLevel to 1

  set TurretSpeed to 0
  set TurretSightDistance to 15
  set TurretHealth to 100
  set TurretWeapon to "Cannon"
  set TurretHostile to true
  set TurretExplosionDeath to true
  set TurretLevel to 4

  # ---- Part I: the rest of TK4's cast ----------------------------------------------------
  # Every type is six rows of data — speed (cm/s), sight (cm), health, weapon, hostile and
  # explosion-death. Nothing about them lives in code: change a number here and the next
  # `enemy type "<name>"` picks it up. The weapon names are WeaponData.events' weapons, so a
  # type's `spawn Bullet` fires that weapon's bullet; a type with no weapon (the Civilian)
  # simply never shoots. `my Hostile` is what `when all enemies dead` and the enemy sheets
  # read, so a non-hostile type neither blocks a cleared level nor gets hunted.

  # Pistolboy — the ordinary TK4 gunner: a pistol, average legs, not much health.
  set PistolboySpeed to 70
  set PistolboySightDistance to 250
  set PistolboyHealth to 45
  set PistolboyWeapon to "Pistol"
  set PistolboyHostile to true
  set PistolboyExplosionDeath to false
  set PistolboyLevel to 3

  # ShotgunManiac — rushes in and lets the spread do the work: short sight, more health.
  set ShotgunManiacSpeed to 80
  set ShotgunManiacSightDistance to 180
  set ShotgunManiacHealth to 55
  set ShotgunManiacWeapon to "Shotgun"
  set ShotgunManiacHostile to true
  set ShotgunManiacExplosionDeath to false
  set ShotgunManiacLevel to 4

  # UziRebel — fast and light, sprays on the move.
  set UziRebelSpeed to 90
  set UziRebelSightDistance to 220
  set UziRebelHealth to 40
  set UziRebelWeapon to "Uzi"
  set UziRebelHostile to true
  set UziRebelExplosionDeath to false
  set UziRebelLevel to 5

  # Commando — the soldier of the bunch: quickest, furthest sight, hardest to drop.
  set CommandoSpeed to 100
  set CommandoSightDistance to 300
  set CommandoHealth to 90
  set CommandoWeapon to "Uzi"
  set CommandoHostile to true
  set CommandoExplosionDeath to false
  set CommandoLevel to 8

  # BazookaBoy — slow, spots you from far away, and the rocket in his hands goes off with him.
  set BazookaBoySpeed to 45
  set BazookaBoySightDistance to 320
  set BazookaBoyHealth to 70
  set BazookaBoyWeapon to "Rocket"
  set BazookaBoyHostile to true
  set BazookaBoyExplosionDeath to true
  set BazookaBoyLevel to 7

  # Civilian — non-hostile, unarmed bystander. They run when shot (Civilian.events).
  set CivilianSpeed to 70
  set CivilianSightDistance to 150
  set CivilianHealth to 30
  set CivilianWeapon to ""
  set CivilianHostile to false
  set CivilianExplosionDeath to false
  set CivilianLevel to 1

  # Punisher — the heavy: slowest of the walkers, twice a zombie's health, tough on purpose.
  set PunisherSpeed to 55
  set PunisherSightDistance to 260
  set PunisherHealth to 120
  set PunisherWeapon to "Shotgun"
  set PunisherHostile to true
  set PunisherExplosionDeath to true
  set PunisherLevel to 10

  # Flamer — short sight, short-range flames, volatile when killed.
  set FlamerSpeed to 65
  set FlamerSightDistance to 170
  set FlamerHealth to 80
  set FlamerWeapon to "Flamer"
  set FlamerHostile to true
  set FlamerExplosionDeath to true
  set FlamerLevel to 6

  # Punk — weak and short-sighted, dangerous only up close.
  set PunkSpeed to 85
  set PunkSightDistance to 150
  set PunkHealth to 35
  set PunkWeapon to "Pistol"
  set PunkHostile to true
  set PunkExplosionDeath to false
  set PunkLevel to 2

  # ---- Task 7 G4 phase 2: arcade lane types -------------------------------------------
  # The lane templates are named after their type, so one shared sheet reads the type from the
  # actor (`enemy type my name`) and every `kills <Type>` counter stays separate. Speeds are
  # cm/s like the rest of the TK table (the lane's Zombie walks at 60).

  # Knife — fast and fragile: closes the gap quickly, drops in three hits.
  set KnifeSpeed to 110
  set KnifeSightDistance to 200
  set KnifeHealth to 30
  set KnifeWeapon to ""
  set KnifeHostile to true
  set KnifeExplosionDeath to false
  set KnifeLevel to 1

  # Brute — slow and heavy: walks the lane at a stump's pace, takes twelve hits.
  set BruteSpeed to 40
  set BruteSightDistance to 150
  set BruteHealth to 120
  set BruteWeapon to ""
  set BruteHostile to true
  set BruteExplosionDeath to false
  set BruteLevel to 2

  # GrenadeGay — lobs grenades from a distance; the bandolier goes up with him.
  set GrenadeGaySpeed to 60
  set GrenadeGaySightDistance to 240
  set GrenadeGayHealth to 55
  set GrenadeGayWeapon to "Grenade"
  set GrenadeGayHostile to true
  set GrenadeGayExplosionDeath to true
  set GrenadeGayLevel to 5

  # ---- Task 21 Part D: the boss -------------------------------------------------------
  # Boss — heavy, far-sighted and slow, with 300 hit points so the two phase gates in
  # Boss.events (200 and 100) sit a third apart. The template actor is named `Boss`, so
  # `enemy type my name` reads this row and `kills Boss` is its own counter.
  # ExplosionDeath is false on purpose: the boss's sheet always spawns its own Explosion, so
  # the flag would only be a second, unread copy of that decision.
  set BossSpeed to 70
  set BossSightDistance to 400
  set BossHealth to 300
  set BossWeapon to ""
  set BossHostile to true
  set BossExplosionDeath to false
  set BossLevel to 15
