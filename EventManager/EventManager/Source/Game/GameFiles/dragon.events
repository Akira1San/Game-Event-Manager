# ---------------- dragon.events ----------------
# WASD moves the dragon, Shift runs, Left Mouse breathes fire.
# Clips come from the BGE Dragon 2.07 import. The plain word "walk" is ambiguous
# (an older import has clips with the same names), so the "animation ..." aliases
# are used for idle/walk/run. The attack clip only exists in the older set.

when me appears
  set my Attacking to false
  camera follows me
  loop anim "animation idle pose"

# ---- walking (WASD, no Shift) ----
when W is held
  unless Left Shift is held
  unless my Attacking is true
  move forward speed 40
  loop anim "animation walk"

when S is held
  unless Left Shift is held
  unless my Attacking is true
  move back speed 40
  loop anim "animation walk"

when A is held
  unless Left Shift is held
  unless my Attacking is true
  move left speed 40
  loop anim "animation walk"

when D is held
  unless Left Shift is held
  unless my Attacking is true
  move right speed 40
  loop anim "animation walk"

# ---- running (Shift + WASD) ----
when Left Shift is held
  W is held
  unless my Attacking is true
  move forward speed 100
  loop anim "animation run"

when Left Shift is held
  S is held
  unless my Attacking is true
  move back speed 100
  loop anim "animation run"

when Left Shift is held
  A is held
  unless my Attacking is true
  move left speed 100
  loop anim "animation run"

when Left Shift is held
  D is held
  unless my Attacking is true
  move right speed 100
  loop anim "animation run"

# ---- back to idle when the last movement key is released ----
when W is released
  unless S is held
  unless A is held
  unless D is held
  unless my Attacking is true
  loop anim "animation idle pose"

when S is released
  unless W is held
  unless A is held
  unless D is held
  unless my Attacking is true
  loop anim "animation idle pose"

when A is released
  unless W is held
  unless S is held
  unless D is held
  unless my Attacking is true
  loop anim "animation idle pose"

when D is released
  unless W is held
  unless S is held
  unless A is held
  unless my Attacking is true
  loop anim "animation idle pose"

# ---- attack: breathe fire once, then resume ----
when Left Mouse is pressed
  unless my Attacking is true
  set my Attacking to true
  play anim "dragon_fire"

when anim "dragon_fire" ends
  set my Attacking to false
  unless W is held
  unless S is held
  unless A is held
  unless D is held
  loop anim "animation idle pose"
