# --- Door.events (locked-door puzzle with inventory selection) ---
# `my Locked` = door state (true while locked). `SelectedItem` = the item the
# player has selected in inventory (a global variable set by clicking a slot).
# Hover hint is gated on `my Locked` so it stops overwriting the unlock message once opened.

when me appears
  set my Locked to true

when me is hovered
  my Locked is true
  show text "A locked door."

when me is clicked
  my Locked is true
  unless SelectedItem is "Key"
  play sound "locked.wav"
  show text "It's locked."

when me is clicked
  my Locked is true
  SelectedItem is "Key"
  play sound "unlock.wav"
  set my Locked to false
  set SelectedItem to ""
  show text "The door creaks open."
