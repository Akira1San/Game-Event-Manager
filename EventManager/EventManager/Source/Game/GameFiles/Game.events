# ---------------- Game.events (global sheet) ----------------
when game starts
  set Score to 0
  set Lives to 3
  show text "Shoot the enemies!"
  wait 2 seconds
  hide text
  set text of ScoreLabel to Score
  set text of LivesLabel to Lives

when every 5 seconds
  unless Score is 5
  spawn Enemy at SpawnPoint

when Score changes
  set text of ScoreLabel to Score

when Lives changes
  set text of LivesLabel to Lives

when Score becomes 5
  show text "You win!"
  wait 3 seconds
  restart scene

when Lives becomes 0
  show text "Game Over"
  wait 3 seconds
  restart scene
