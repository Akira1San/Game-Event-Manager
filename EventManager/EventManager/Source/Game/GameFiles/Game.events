# ---------------- Game.events (global sheet: game states) ----------------
# Global state machine: menu -> playing -> paused -> gameover -> restart.
# Driven entirely by set state / when state is / state gates.

when game starts
  #camera free
  set Score to 0
  set Lives to 3
  # Per-player counters (Task 16 Part F): a two-word global, `Player<n> Score/Lives/Kills`.
  set Player1 Score to 0
  set Player1 Lives to 3
  set Player1 Kills to 0
  set Player2 Score to 0
  set Player2 Lives to 3
  set Player2 Kills to 0
  set time scale to 1
  print "Game started"
  set state menu
  #for rts minimap - enable for rts test demo
  #set MinimapExtent to 400
  #set MinimapSize to 128
  #set MinimapGrid to 0

when state is menu
  print "State: menu"
  set time scale to 1
  show text "Title Screen"
  show PlayButton
  show QuitButton
  hide PausePanel
  hide GameOverPanel

when PlayButton is clicked
  print "Clicked PlayButton"
  set state playing

when QuitButton is clicked
  print "Clicked QuitButton"
  quit game

when state is playing
  print "State: playing"
  set time scale to 1
  set text of ScoreLabel to Score
  set text of LivesLabel to Lives
  hide PausePanel
  hide GameOverPanel

when P is pressed
  unless state is paused
  set state paused

when P is pressed state paused
  print "P unpause"
  set state playing

when state is paused
  print "State: paused"
  set time scale to 0
  show PausePanel
  show ResumeButton
  show QuitButton

when PauseButton is clicked
  print "Clicked PauseButton"
  set time scale to 0

when ResumeButton is clicked
  print "Clicked ResumeButton"
  set state playing

when QuitButton is clicked state paused
  print "Clicked QuitButton (paused)"
  quit game

when Lives becomes 0
  unless state is gameover
  print "Lives = 0"
  set state gameover

when state is gameover
  print "State: gameover"
  show text "Game Over"
  show GameOverPanel
  show RestartButton
  hide PausePanel

when RestartButton is clicked
  print "Clicked RestartButton"
  restart scene

# ---------------- local multiplayer (Task 16 Part F) ----------------
# Two players, one PC, one screen: Player1 and Player2 each carry TK_Player.events. Nothing
# here talks to a network — the runtime watches the two player slots and raises the edges.
#
# `Player1 Score` and friends are ordinary globals written with the two-word variable shape
# (`set` / `add` / `when ... changes` all read it), so saving or wiping them is the same as
# any other variable. `my TargetPlayer` is computed per actor: the nearest player.
when player 1 joins
  print "Player 1 joined"

when player 2 joins
  print "Player 2 joined"

# Co-op lives: each player spends their own, and the shared `Score` keeps climbing.
when player 1 dies
  add -1 to Player1 Lives

when player 2 dies
  add -1 to Player2 Lives

# Deathmatch scoring. A kill is credited to the other player when the last `"damage"` on the
# victim came from that player — every projectile carries `my shooter`, so a bullet's hit is
# traced back to whoever fired it, not to the clone.
when player 1 kills player 2
  add 1 to Player1 Kills
  add 1 to Player1 Score

when player 2 kills player 1
  add 1 to Player2 Kills
  add 1 to Player2 Score

when Player1 Score changes
  print "Player 1 score changed"

# Co-op game over: the run ends only when nobody is left standing.
when all players dead
  unless state is gameover
  print "All players dead"
  set state gameover

# ---------------- level progression & statistics (Task 16 Part G) ----------------
# A level is a scene. Every enemy type tags its own actor with `my Type` (Task 16 Part D),
# so `when all enemies dead` fires once per level when the last of them is gone — a scene
# with no enemies at all never claims a cleared level. `next level` raises
# `when level completes` and then loads the next scene in the level order the bridge fills
# in from the project's scenes.
#
# The run's statistics are ordinary globals, so a HUD can bind or print them:
#   Kills Total, Kills <type>     from `add 1 to kills <type>` on the enemy death sheets
#   Shots, Hits, Accuracy          one `spawn Bullet` from a player, one `"damage"` on an enemy
#   Time Elapsed                   seconds spent in this level
#   LevelName, LevelNumber         the current level (1-based)
when level starts
  print "Level started"

when level completes
  print "Level complete!"

when all enemies dead
  show text "Level complete!"
  wait 2
  next level
