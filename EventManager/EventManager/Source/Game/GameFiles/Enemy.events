# ---------------- Enemy.events (patrol -> chase -> attack) ----------------
# Typed enemy (Task 16 Part D): the type supplies every base stat as a `my` variable —
# Speed, SightDistance, Health, Weapon, Hostile, ExplosionDeath — so nothing below
# hard-codes them. See EnemyTypes.events for the data table (Zombie, Turret, your own).
when me appears
  enemy type "Zombie"
  set my mode to "patrol"
  print "Enemy: patrol start"
  goto random Waypoint speed 100 facing forward             # pathfinds around walls automatically
  # loop anim "Walk"   # simple mesh — no animation

when me arrives at Waypoint
  my Speed is higher than 0                  # a rooted type (Turret) never wanders
  wait random 0.5 to 2 seconds
  goto random Waypoint speed 100

when me sees player by my SightDistance      # one-shot the moment a player is spotted,
  my Speed is higher than 0                  # as far as this type's eyes reach
  set my mode to "chase"
  print "Enemy: chase start"
  # loop anim "Run"   # simple mesh — no animation
  goto nearest player speed 100 facing forward

# ---- hearing (Task 16 Part B): a gunshot it can hear brings it running ----
# `other` is where the noise came from, so `goto other` walks toward the shot even while the
# shooter is still out of sight. A wall between the two muffles it — no trigger.
when me hears "gunshot" by my SightDistance
  my Hostile is true                         # only hostile types investigate shots
  set my mode to "chase"
  print "Enemy: heard a gunshot"
  goto other speed 100 facing forward

when every 0.2 seconds                     # chase keeps re-targeting the moving player
  my mode is "chase"
  my Speed is higher than 0
  goto nearest player speed 100 facing forward

when me stops seeing player                # went out of sight — resume patrol
  set my mode to "patrol"
  print "Enemy: lost sight, back to patrol"

when me is near player by 1.5
  my mode is "chase"
  my Hostile is true                         # only hostile types attack
  print "Enemy: attack — sending hurt to Player"
  play anim "Attack"
  send message "hurt" to nearest player

# ---- taking a bullet: every shot costs 10 of the enemy's 100 hit points ----
when message "hit" arrives
  add -10 to my health
  print "Enemy: hit for 10"

# A hit can never undershoot (100 - 10 lands exactly on 0), but other damage can — keep the
# bar honest with a clamped watch instead of a condition-shaped trigger.
when my health changes
  if my health is lower than 0
  set my health to 0

# ---- taking damage (D2 loop) ----
when message "damage" arrives
  # Part E: the spray appears at the body, not wherever the bullet flew on to.
  spawn Blood at me
  set my LastDmg to other's damage      # possessive read: the attacker's stat
  set my health to my health - my LastDmg

# ---- death drops loot ----
when my health becomes 0
  # Part G: the type this enemy was given counts the kill (`my Type`).
  add 1 to kills my Type
  # Part E: gibs for every type, and an `ExplosionDeath` type (Turret) bursts instead of
  # leaving chunks — `my ExplosionDeath` comes from the enemy-type data (Task 16 Part D).
  chance 30%
  spawn Sword at me
  if my ExplosionDeath is true
  spawn Explosion at me
  otherwise
  spawn Gib at me offset 0
  spawn Gib at me offset 12
  spawn Gib at me offset -12
  destroy me
